# RawQR Environment Configuration

# Server Port
PORT=5000

# Cloud Storage Option 1: Cloudinary (Recommended)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloud Storage Option 2: Supabase Storage
# Sign up free at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_BUCKET=rawqr-images
